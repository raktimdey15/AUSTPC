# ── Server ────────────────────────────────────────────────────────────────
PORT=5000
# Comma-separated list of allowed frontend origins.
CLIENT_ORIGIN=http://localhost:5173
# Set to true only when running behind a reverse proxy (nginx, Render, etc.).
TRUST_PROXY=false

# ── Admin auth ────────────────────────────────────────────────────────────
ADMIN_USERNAME=austpc_admin
# Preferred: SHA-256 hex hash of the admin password.
#   node -e "console.log(require('crypto').createHash('sha256').update('YourPassword').digest('hex'))"
ADMIN_PASSWORD_HASH=
# Dev-only fallback if no hash is set.
ADMIN_PASSWORD=Admin@2026!
# Long random string used to sign admin session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_TOKEN_SECRET=change_this_to_a_long_random_string
ADMIN_TOKEN_TTL_SECONDS=28800

# ── MongoDB ───────────────────────────────────────────────────────────────
# Local development: run `npm run db` (zero-install persistent MongoDB), which
# serves exactly this URI. Production: use MongoDB Atlas or a self-hosted server.
MONGODB_URI=mongodb://127.0.0.1:27017/austpc
# Port used by `npm run db` (keep in sync with MONGODB_URI).
LOCAL_DB_PORT=27017

# ── Image storage ─────────────────────────────────────────────────────────
# auto  = use S3 when credentials are set, otherwise store files locally
# local = always store under Backend/uploads (served at /uploads)
# s3    = always use S3 (requires the AWS_* settings below)
STORAGE_DRIVER=auto
# Public base URL of THIS backend, used to build URLs for local uploads.
# Leave empty for http://localhost:PORT. Set when deployed, e.g. https://api.austpc.com
PUBLIC_BASE_URL=

# ── AWS S3 (or any S3-compatible provider e.g. Cloudflare R2, MinIO) ──────
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=austpc-uploads
# Only set for non-AWS S3-compatible endpoints (R2, MinIO, Supabase):
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true
