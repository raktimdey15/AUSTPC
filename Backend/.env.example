# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Admin auth
ADMIN_USERNAME=austpc_admin
# Use a SHA-256 hash of the admin password for ADMIN_PASSWORD_HASH.
# For local development only, ADMIN_PASSWORD is supported as a fallback.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=Admin@2026!
ADMIN_TOKEN_SECRET=change_this_to_a_long_random_string
ADMIN_TOKEN_TTL_SECONDS=28800

# MongoDB (self-hosted or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/austpc

# AWS S3 (or any S3-compatible provider e.g. Cloudflare R2, MinIO, Supabase Storage w/ S3 API)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
S3_BUCKET_NAME=austpc-uploads

# Optional: only set if using an S3-compatible endpoint that isn't AWS (e.g. R2, MinIO)
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true
